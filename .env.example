# Run python3 scripts/configure.py to generate local database secrets.
POSTGRES_PASSWORD=replace_with_generated_hex
WEB_DB_PASSWORD=replace_with_generated_hex
HOST_DATA_PATH=/absolute/path/to/pokoscrap/runtime
DOCKER_SOCKET=/var/run/docker.sock
WEB_PORT=8877
BASE_URL=http://127.0.0.1:8877
COOKIE_SECURE=0
# Tripay Sandbox only. Keep disabled until beta rules and merchant configuration are ready.
BILLING_BETA_ENABLED=0
TRIPAY_API_KEY=
TRIPAY_PRIVATE_KEY=
TRIPAY_MERCHANT_CODE=
# Without SMTP, development messages are saved in runtime/outbox/*.eml.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@pokoscrap.example
